ENVIRONMENT=development
DEBUG=true

# Runtime connection: use a restricted, non-superuser role in any real
# deployment (see backend/db-init/01-create-app-role.sql) — Postgres
# superusers always bypass Row-Level Security, so connecting as one makes
# every RLS policy silently do nothing. Docker Compose already wires this up
# via subgym_app; this bare default is only for a quick local `alembic
# upgrade head` + manual poking against a throwaway superuser Postgres.
DATABASE_URL=postgresql+asyncpg://subgym:subgym@localhost:5432/subgym
# Used by `alembic upgrade head` (needs table-owner privileges). Defaults to
# DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgresql+asyncpg://subgym:subgym@localhost:5432/subgym
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-secret-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Root domain gyms are routed under, e.g. "acme.subgym.io" -> subdomain "acme".
BASE_DOMAIN=subgym.io

CHECKIN_CACHE_TTL_SECONDS=30
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_CHECKIN=60/60
